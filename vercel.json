{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/admin/login", "destination": "/api/admin/session?op=login" },
    { "source": "/api/admin/logout", "destination": "/api/admin/session?op=logout" }
  ],
  "functions": {
    "api/admin/docs/[action].js": { "maxDuration": 60, "includeFiles": "api/_lib/fonts/**" },
    "api/admin/requests/[id].js": { "includeFiles": "api/_lib/fonts/**" },
    "api/admin/requests/index.js": { "includeFiles": "api/_lib/fonts/**" },
    "api/mcp.js": { "includeFiles": "api/_lib/fonts/**" },
    "api/contact.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/tg-client",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
